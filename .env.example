# Copy to .env only for a new checkout. Never overwrite existing secrets.
NODE_ENV=development
# Separate local databases; substitute URL-encoded passwords from Bitwarden.
DIE_DATABASE_URL=postgresql://die_dev:REPLACE_ME@127.0.0.1:5432/die_dev
UMAMI_DEV_DATABASE_URL=postgresql://umami_dev:REPLACE_ME@127.0.0.1:5432/umami_dev
# The health-only service does not open either database yet.
